# Copy to .env and fill in. Never commit .env.

# --- LLM (Groq) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (local, downloaded on first use) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Database ---
# Local run (uvicorn on your machine):
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tennis_db
# Docker Compose builds its own DATABASE_URL from these three:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tennis_db

# --- App ---
APP_ENV=development
